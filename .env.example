PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DEMO_MODE=false
NODE_ENV=development
DATABASE_URL=postgresql://dinsat:replace-with-your-local-password@127.0.0.1:55432/dinsat
# Separate, disposable database. Never point tests at application or production data.
TEST_DATABASE_URL=postgresql://dinsat:replace-with-your-local-password@127.0.0.1:55432/dinsat_test
DB_POOL_MAX=5
TRUST_PROXY=0
COOKIE_SAME_SITE=lax
# For a cloud provider requiring TLS without SSL parameters in its URL:
# PGSSLMODE=verify-full
# Heroku buildpack stack CA bundle; use the provider-specific path in other environments:
# NODE_EXTRA_CA_CERTS=/usr/lib/ssl/certs/ca-certificates.crt
