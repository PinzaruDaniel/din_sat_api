{
  "name": "din-sat-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/app/server.js",
    "start": "node --env-file-if-exists=.env src/app/server.js",
